# Your Supabase project's web address (found in Supabase: Project Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (public) key. Safe in the browser because database security rules (RLS) still protect your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key bypasses all security rules. Server-only: NEVER add a NEXT_PUBLIC_ prefix, which would expose it to every visitor.
SUPABASE_SECRET_KEY=
