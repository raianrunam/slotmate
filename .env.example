# Your Supabase project's web address (found in Supabase: Project Settings > Data API (or the Connect button)). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable (public) key. Safe in the browser because database security rules (RLS) still protect your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key bypasses all security rules. Server-only: NEVER add a NEXT_PUBLIC_ prefix, which would expose it to every visitor.
SUPABASE_SECRET_KEY=
# The address where the app runs (no trailing slash): http://localhost:3000 in development. Used for the links in sign-up and password-reset emails. Safe to expose to the browser.
NEXT_PUBLIC_APP_URL=

# Stripe (test mode only, Phase 15). Names only: put the real values in .env.local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
